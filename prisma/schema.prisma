generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  ingredients  String
  instructions String
  prepTime     Int
  cookTime     Int
  servings     Int
  category     String
  imageUrl     String?
  createdAt    DateTime @default(now())
}

model MealPlan {
  id        Int    @id @default(autoincrement())
  date      String @unique
  breakfast Int?
  lunch     Int?
  dinner    Int?
}

model WorkoutSession {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  date      String
  exercises String
  notes     String?
  createdAt DateTime @default(now())
}

model ValorantTip {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String
  agent     String?
  drill     String?
  createdAt DateTime @default(now())
}

model Trade {
  id         Int      @id @default(autoincrement())
  date       String
  instrument String
  type       String
  entry      Float
  exit       Float?
  size       Float
  pnl        Float?
  notes      String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}

model BacktestStrategy {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  rules       String
  timeframe   String
  winRate     Float?
  riskReward  Float?
  notes       String?
  createdAt   DateTime @default(now())
}

model NoteCategory {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#2d6a4f")
  emoji     String   @default("📝")
  createdAt DateTime @default(now())
}

model Note {
  id         Int      @id @default(autoincrement())
  categoryId Int
  title      String
  rules      String
  examples   String
  quiz       String?
  createdAt  DateTime @default(now())
}

model WorkoutVideo {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  types     String   @default("[]")
  createdAt DateTime @default(now())
}

model FoodVideo {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  types     String   @default("[]")
  createdAt DateTime @default(now())
}

model MealOverride {
  id          Int     @id @default(autoincrement())
  mealId      Int     @unique
  name        String?
  type        String?
  protein     String?
  kcal        String?
  time        String?
  ingredients String?
  prep        String?
  tip         String?
}

model RajaPhoto {
  id        Int      @id @default(autoincrement())
  title     String
  year      String
  imageData String
  mood      String?
  createdAt DateTime @default(now())
}

model WeekScheduleData {
  id   Int    @id @default(1)
  data String @default("{}")
}

model BuyListData {
  id    Int    @id @default(1)
  items String @default("[]")
}

model AppPreference {
  key   String @id
  value String @default("[]")
}

model PreTradeState {
  id   Int    @id @default(1)
  data String @default("{}")
}
